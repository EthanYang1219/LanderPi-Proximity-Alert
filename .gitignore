# Local cache of the robot's ROS 2 Python packages, pulled from the MentorPi
# container solely so Pylance/pyright can resolve rclpy/geometry_msgs/etc.
# imports. Not part of the actual runtime (that's inside Docker) and not
# portable across machines -- regenerate with:
#   docker cp MentorPi:/opt/ros/humble/local/lib/python3.10/dist-packages .ros2_stubs/dist-packages
.ros2_stubs/

__pycache__/
*.pyc

trials/

# organized_data/ is the published research dataset: the per-surface trial
# logs and the decision log are committed so the results are reproducible
# from this repository alone. Scan traces are NOT -- scan_trace.jsonl is
# ~1 GB and lives at trials/ / /home/pi/docker/tmp/trials/ instead.
organized_data/**/*.jsonl

# Claude Code harness state (spawned-task worktrees, etc.), not project content.
.claude/
